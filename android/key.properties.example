# Copy this file to android/key.properties and fill in the real values.
#
# key.properties is gitignored on purpose — it contains the keystore password.
# Never commit it, and never share the .jks file publicly. If the upload key is
# lost you cannot publish updates to the existing listing without asking Google
# to reset it.

storeFile=stu-upload-key.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
